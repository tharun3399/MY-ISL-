# Railway Environment Variables Template
# Copy these to your Railway project settings

# Server Configuration
PORT=8000
NODE_ENV=production
FRONTEND_ORIGIN=https://web-production-16bf1.up.railway.app

# Database Configuration (Railway PostgreSQL)
PGHOST=your-railway-postgres-host
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your-railway-db-password
PGDATABASE=railway

# JWT Configuration
JWT_SECRET=your-very-secure-random-secret-key-change-this

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
