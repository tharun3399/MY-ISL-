# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Configuration
FRONTEND_ORIGIN=http://localhost:5173

# JWT Configuration
JWT_SECRET=your_strong_random_secret_key_min_32_chars_recommended
JWT_EXPIRES_IN=1h

# Important Security Notes:
# 1. Never commit .env to git - add it to .gitignore
# 2. JWT_SECRET should be a strong random string (use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# 3. PGPASSWORD should be a strong database password
# 4. Set NODE_ENV=production in production environments
# 5. In production, ensure HTTPS is enabled (secure cookies will be true)
